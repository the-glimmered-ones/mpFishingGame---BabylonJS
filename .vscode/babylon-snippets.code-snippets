		"description": "Shortcut for implementing the babylon framework"
	},
	"New Vector3": {
		"scope": "javascript,typescript",
		"prefix": "vec3",
		"body": [
			"new BABYLON.Vector3(${1:0}, ${2:0}, ${3:0})",
		],
		"description": "Create a new BabylonJS vector"
	}
